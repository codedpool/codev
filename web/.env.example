# --- Auth (Clerk) — https://dashboard.clerk.com → API keys
# Leave both empty in development to use Clerk "keyless" mode (a temporary app is created for you).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Data
MONGO_URI=mongodb+srv://...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET_NAME=...

# --- AI (Groq, free tier) — https://console.groq.com
GROQ_API_KEY=gsk_...
# Optional overrides (defaults: openai/gpt-oss-120b for chat, openai/gpt-oss-20b for inline completions)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b

# --- AI fallback (Google Gemini) — https://aistudio.google.com/apikey
# Used automatically whenever a Groq call fails (quota, outage, retired model). Optional but recommended.
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# --- Code runner (see runner/README.md). Without any of these, development uses the "local" runner (host toolchains).
JUDGE0_URL=https://ce.judge0.com              # Judge0 public CE instance: free, no key, rate-limited (~40 languages)
# JUDGE0_URL=http://localhost:2358            # ...or self-hosted Judge0 (+ JUDGE0_AUTH_TOKEN if enabled)
# JUDGE0_RAPIDAPI_KEY=                        # ...or hosted Judge0 on RapidAPI
# PISTON_URL=http://localhost:2000/api/v2     # ...or self-hosted Piston (docker compose in web/runner)
# JDOODLE_CLIENT_ID=
# JDOODLE_CLIENT_SECRET=
# RUNNER=piston|judge0|jdoodle|local|none     # force a runner (default: auto)
# RUN_TIMEOUT_MS=5000

# --- Real-time collaboration (optional). Run `npm run collab` (COLLAB_PORT, default 1234) and set this to enable it.
# NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234

# --- In-browser Python (Pyodide from jsDelivr). Optional version pin.
# NEXT_PUBLIC_PYODIDE_VERSION=314.0.5
